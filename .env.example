# ============================================================
# Registro Mercantil de Cuba — Variables de Entorno
# Generado automáticamente
# Entorno: desarrollo
# ============================================================

# Base de datos — PostgreSQL (desarrollo y producción)
DATABASE_URL=postgresql://usuario:password@localhost:5432/registro_mercantil
DB_PROVIDER=postgresql

# Base de datos — SQLite (desarrollo alternativo)
# DATABASE_URL=file:/var/www/html/registro-mercantil-portal/db/custom.db
# DB_PROVIDER=sqlite

# Autenticación — JWT
# Genera uno nuevo con: openssl rand -hex 32
JWT_SECRET=

# Uploads — límites independientes en megabytes
UPLOAD_MAX_FILE_MB=5
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOCUMENT_MB=20
UPLOAD_MAX_VIDEO_MB=100

# Next.js — URL pública
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Traefik — Dominio para routing
TRAEFIK_HOST=registro-mercantil.local

# Proxy corporativo (opcional - descomentar si es necesario)
# HTTP_PROXY=http://usuario:password@proxy.ejemplo.com:3128
# HTTPS_PROXY=http://usuario:password@proxy.ejemplo.com:3128

# Registro Docker privado (opcional)
# DOCKER_REGISTRY=registry.ejemplo.com/                 