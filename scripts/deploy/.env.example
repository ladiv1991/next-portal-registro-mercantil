# Portal Registro Mercantil — Variables de Entorno
# Copiar a .env y modificar con los valores correctos

# ── Base de datos ──────────────────────────────────────────
# Formato: postgresql://usuario:contraseña@host:puerto/base
DATABASE_URL=postgresql://portal_rmc:TU_PASSWORD_AQUI@host-db:5433/registro_mercantil

# ── JWT (mínimo 32 caracteres aleatorios) ──────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=TU_JWT_SECRET_AQUI_CON_ALMENOS_32_CARACTERES

# ── Opcionales ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000
